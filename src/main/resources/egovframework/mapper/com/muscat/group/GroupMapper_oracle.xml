<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.com.muscat.group.mapper.GroupMapper">
	<resultMap type="egovframework.com.muscat.group.service.GroupVO" id="detailUser">
	<result property="id" column="id"/>
	<result property="text" column="text"/>
	<result property="parent" column="parent"/>
	<result property="type" column="type"/>
	
	<association property="data" javaType="egovframework.com.muscat.group.service.UserVO">
    <result property="rank" column="rank"/>
    <result property="job" column="job"/>
    <result property="name" column="name"/>
    <result property="dept" column="dept"/>
    <result property="rank_nm" column="rank_nm"/>
  </association>
	
	
	</resultMap>
	
	
	<select id="selectGroupChart" resultType="egovframework.com.muscat.group.service.GroupVO">
		<!-- 부서 목록 조회 -->
		Select * 
		from vw_department
	</select>

	<select id="selectgetGroupData"
		resultType="egovframework.com.muscat.group.service.GroupwithVO">
		select
		d.dept_id,
		d.dept_name,
		d.sort_order,
		s.dept_id,
		s.dept_name,
		s.sort_order,
		s.parent_dept_id

		from department d join subdepartment s on d.dept_id = s.parent_dept_id
	</select>

	<select id="selectGroupUser" resultMap="detailUser" >
		select v.id || gu.mber_id as id,
		gu.mber_id as text,
		gu.dept_id as parent,
		'user' as type,
		gu.rank,
		gu.job,
		gu.mber_id as name,
		gu.dept_id as dept,
		find_codename(rank, 'COM103') rank_nm
		FROM COMTNGNRLMBER gu join vw_department v on v.id = gu.dept_id
	</select>

</mapper>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
	namespace="egovframework.com.muscat.appr.mapper.ApprMapper">

	<select id="selectTime" resultType="string">
		SELECT SYSDATE FROM DUAL
	</select>
	
	<insert id="insertDocForm" parameterType="docFormVO">
		INSERT INTO DOCFORM VALUES 
		('DOC-' || TO_CHAR(DOCFORM_SEQ.nextval)
		, #{dformName}
		, #{dformContent}
		, SYSDATE
		, SYSDATE
		, #{dformDesc}
		, #{useYn}
		)
	</insert>

</mapper>